# Website Environment Variables
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Cloudflare Turnstile public site key (must match the Turnstile SECRET
# configured in Supabase Dashboard -> Auth -> Bot and Abuse Protection).
# EXPO_PUBLIC_ prefix works too (vite envPrefix includes it).
EXPO_PUBLIC_CAPTCHA_SITE_KEY=your-turnstile-site-key
