{
  "rewrites": [
    { "source": "/auth/callback", "destination": "/index.html" },
    { "source": "/auth/error",    "destination": "/index.html" },
    { "source": "/sign-in",       "destination": "/index.html" },
    { "source": "/sign-up",       "destination": "/index.html" },
    { "source": "/forgot-password","destination": "/index.html" },
    { "source": "/reset-password", "destination": "/index.html" },
    { "source": "/privacy",        "destination": "/index.html" },
    { "source": "/terms",          "destination": "/index.html" },
    { "source": "/404",            "destination": "/index.html" },
    { "source": "/(.*)",           "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options",  "value": "nosniff" },
        { "key": "X-Frame-Options",         "value": "DENY" },
        { "key": "Referrer-Policy",         "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",      "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/success.html",
      "headers": [
        { "key": "Cache-Control",         "value": "no-store, no-cache, must-revalidate" },
        { "key": "Pragma",                "value": "no-cache" },
        { "key": "X-Robots-Tag",          "value": "noindex, nofollow" }
      ]
    }
  ]
}
