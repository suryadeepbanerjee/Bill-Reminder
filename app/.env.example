# ── Supabase (Expo app) ──────────────────────────────────────────────────────
# MUST use EXPO_PUBLIC_ prefix — Metro only injects vars with this prefix.
# Find these at: https://supabase.com/dashboard → Project → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Supabase (Edge Functions only — never exposed to the client) ──────────────
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=auth@billreminder.suryadeepbanerjee.in

# ── App Configuration ─────────────────────────────────────────────────────────
APP_SCHEME=bill-reminder
SUPABASE_REDIRECT_URL=bill-reminder://callback
