# ── Supabase (Expo app) ──────────────────────────────────────────────────────
# MUST use EXPO_PUBLIC_ prefix — Metro only injects vars with this prefix.
# Find these at: https://supabase.com/dashboard → Project → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Google Sign-In (Expo app) ────────────────────────────────────────────────
# The Web client ID of the OAuth client registered in Google Cloud Console.
# https://console.cloud.google.com/apis/credentials → OAuth 2.0 Client IDs
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id

# ── EAS (Expo app) ───────────────────────────────────────────────────────────
# Project ID from https://expo.dev → your project → Project settings
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id

# ── Supabase (Edge Functions only — never exposed to the client) ──────────────
# Set via: npx supabase secrets set RESEND_API_KEY=re_your_key_here
RESEND_API_KEY=your-resend-api-key

# ── App Configuration ─────────────────────────────────────────────────────────
APP_SCHEME=bill-reminder
SUPABASE_REDIRECT_URL=bill-reminder://callback
